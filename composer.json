{
  "name": "refatbd/game-account-lookup",
  "description": "Framework-independent PHP toolkit and local test template for resolving game account nicknames from player IDs through pluggable validation providers.",
  "keywords": [
    "game",
    "uid",
    "player-id",
    "nickname",
    "ign",
    "free-fire",
    "pubg-mobile",
    "mobile-legends",
    "codashop",
    "gopay",
    "laravel",
    "game-account",
    "player-lookup",
    "uid-checker",
    "api",
    "template"
  ],
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/refatbd/game-account-lookup",
  "support": {
    "issues": "https://github.com/refatbd/game-account-lookup/issues",
    "source": "https://github.com/refatbd/game-account-lookup"
  },
  "authors": [
    {
      "name": "RefatBD",
      "homepage": "https://github.com/refatbd",
      "role": "Maintainer"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "Refatbd\\GameAccountLookup\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Refatbd\\GameAccountLookup\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Refatbd\\GameAccountLookup\\Laravel\\GameAccountLookupServiceProvider"
      ],
      "aliases": {
        "GameAccountLookup": "Refatbd\\GameAccountLookup\\Laravel\\Facades\\GameAccountLookup"
      }
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:standalone": "@php -d zend.assertions=1 -d assert.exception=1 tests/run.php",
    "lint": "@php tools/lint.php",
    "docs:games": "@php tools/generate-supported-games.php",
    "test:docs": "@php tools/check-generated-docs.php",
    "test:template": "@php tests/template-smoke.php",
    "quality": [
      "@lint",
      "@test:standalone",
      "@test",
      "@test:docs",
      "@test:template"
    ],
    "audit:providers": "@php tools/audit-provider-catalog.php",
    "audit:providers-live": "@php tools/audit-provider-catalog.php --live"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "bin": [
    "bin/game-lookup"
  ]
}
